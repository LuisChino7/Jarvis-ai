<!DOCTYPE html>
<html lang="es">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CHINO AI</title>

<style>

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #050b14;
    color: white;
    text-align: center;
}

header {
    padding: 30px 20px 15px;
}

h1 {
    font-size: 42px;
    margin: 0;
    color: #00d9ff;
    text-shadow: 0 0 20px #00d9ff;
}

.subtitle {
    color: #8ea5b8;
    margin-top: 8px;
}

.chat {
    width: 90%;
    max-width: 700px;
    height: 400px;
    margin: 25px auto;
    background: #0b1420;
    border: 1px solid #17354d;
    border-radius: 20px;
    padding: 20px;
    box-sizing: border-box;
    overflow-y: auto;
    text-align: left;
}

.message {
    margin: 12px 0;
    padding: 12px 15px;
    border-radius: 12px;
    max-width: 80%;
    white-space: pre-wrap;
}

.CHINO {
    background: #102638;
    border-left: 3px solid #00d9ff;
}

.user {
    background: #17351f;
    margin-left: auto;
    border-right: 3px solid #00ff88;
}

.input-area {
    width: 90%;
    max-width: 700px;
    margin: auto;
    display: flex;
    gap: 10px;
}

input {
    flex: 1;
    padding: 15px;
    border-radius: 12px;
    border: 1px solid #24445c;
    background: #0b1420;
    color: white;
    font-size: 16px;
    outline: none;
}

button {
    padding: 14px 18px;
    border: none;
    border-radius: 12px;
    background: #00bcd4;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #00e5ff;
}

.modules {
    margin: 30px auto;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
}

.module {
    background: #101d2b;
    border: 1px solid #1d4058;
}

.status {
    margin-top: 10px;
    color: #00ff88;
    font-size: 13px;
}

</style>
</head>

<body>

<header>

<h1>CHINO AI</h1>

<p class="subtitle">
Asistente central de IA personal
</p>

<div class="status">
● Sistema CHINO 3.0 activo
</div>

</header>


<div class="chat" id="chat">

<div class="message CHINO">

🤖 <strong>CHINO:</strong>

Sistema iniciado.

Estoy listo para ayudarte. ¿Qué vamos a construir hoy?

</div>

</div>


<div class="input-area">

<input
type="text"
id="userInput"
placeholder="Escribe un mensaje..."
onkeydown="if(event.key === 'Enter') enviarMensaje()"
>

<button onclick="enviarMensaje()">
Enviar
</button>

</div>


<div class="modules">

<button class="module" onclick="modulo('Biblia')">
📖 Biblia
</button>

<button class="module" onclick="modulo('Música')">
🎵 Música
</button>

<button class="module" onclick="modulo('Podcast')">
🎙️ Podcast
</button>

<button class="module" onclick="modulo('Asistente')">
🧠 Asistente
</button>

</div>


<script>

/* =====================================================
   CHINO AI 3.0
   SISTEMA CENTRAL
===================================================== */


/* =====================================================
   CONFIGURACIÓN PRINCIPAL
===================================================== */

const CHINO = {

    nombre: "CHINO",

    version: "3.0",

    personalidad: "cercana",

    moduloActual: "Asistente",

    estado: "activo",

    contexto: {

        proyecto: null,

        tema: null,

        audiencia: null,

        detalles: []

    }

};


/* =====================================================
   MEMORIA TEMPORAL
===================================================== */

let memoriaConversacion = [];


function guardarMemoria(rol, mensaje) {

    memoriaConversacion.push({

        rol: rol,

        mensaje: mensaje,

        fecha: new Date().toISOString()

    });

}


function obtenerMemoria() {

    return memoriaConversacion.slice(-10);

}


function limpiarMemoria() {

    memoriaConversacion = [];

}


/* =====================================================
   NORMALIZAR TEXTO
===================================================== */

function normalizarTexto(texto) {

    return texto
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();

}


/* =====================================================
   ANALIZAR INTENCIÓN
===================================================== */

function analizarIntencion(mensaje) {

    const texto = normalizarTexto(mensaje);


    /* ---------------------------------------------
       CONTINUACIÓN DE CONVERSACIÓN
    --------------------------------------------- */

    const esContinuacion =

        texto.startsWith("sobre ") ||

        texto.startsWith("acerca de ") ||

        texto.startsWith("para ") ||

        texto.includes("dame 3 puntos") ||

        texto.includes("3 puntos") ||

        texto.includes("tres puntos") ||

        texto.includes("hazme 3 puntos") ||

        texto.includes("quiero 3 puntos") ||

        texto.includes("agrega ") ||

        texto.includes("tambien ") ||

        texto.includes("ahora ") ||

        texto.includes("que sea ") ||

        texto.includes("dame ") ||

        texto.includes("hazlo ") ||

        texto.includes("desarrolla el punto") ||

        texto.includes("desarrollar el punto") ||

        texto.includes("explica el punto");


    if (

        esContinuacion &&

        CHINO.moduloActual !== "Asistente"

    ) {

        return {

            modulo: CHINO.moduloActual,

            intencion: "continuacion",

            confianza: 0.95

        };

    }


    /* ---------------------------------------------
       BIBLIA
    --------------------------------------------- */

    if (

        texto.includes("biblia") ||

        texto.includes("predica") ||

        texto.includes("predicar") ||

        texto.includes("sermon") ||

        texto.includes("versiculo") ||

        texto.includes("estudio biblico")

    ) {

        return {

            modulo: "Biblia",

            intencion: "biblia",

            confianza: 0.95

        };

    }


    /* ---------------------------------------------
       MÚSICA
    --------------------------------------------- */

    if (

        texto.includes("musica") ||

        texto.includes("acordes") ||

        texto.includes("acorde") ||

        texto.includes("guitarra") ||

        texto.includes("teclado") ||

        texto.includes("bateria") ||

        texto.includes("adoracion")

    ) {

        return {

            modulo: "Música",

            intencion: "musica",

            confianza: 0.90

        };

    }


    /* ---------------------------------------------
       PODCAST
    --------------------------------------------- */

    if (

        texto.includes("podcast") ||

        texto.includes("guion") ||

        texto.includes("preguntas para podcast")

    ) {

        return {

            modulo: "Podcast",

            intencion: "podcast",

            confianza: 0.90

        };

    }


    /* ---------------------------------------------
       ASISTENTE
    --------------------------------------------- */

    return {

        modulo: "Asistente",

        intencion: "general",

        confianza: 0.70

    };

}


/* =====================================================
   GENERAR RESPUESTA
===================================================== */

function generarRespuesta(mensaje, analisis) {

    const texto = normalizarTexto(mensaje);


    /* =================================================
       SALUDO
    ================================================= */

    if (

        texto === "hola" ||

        texto === "hey" ||

        texto.includes("hola chino")

    ) {

        return `
👋 Hola bro.

Soy CHINO AI.

Estoy listo para trabajar contigo.

📖 Biblia
🎵 Música
🎙️ Podcast
🧠 Asistente

¿Qué vamos a construir hoy?
`;

    }


    /* =================================================
       DETECTAR PRÉDICA
    ================================================= */

    if (

        texto.includes("predica") ||

        texto.includes("predicar") ||

        texto.includes("sermon")

    ) {

        CHINO.moduloActual = "Biblia";

        CHINO.contexto.proyecto = "predica";


        return `
📖 MODO PRÉDICA ACTIVADO

Perfecto bro.

Vamos a preparar una prédica.

Ahora dime el tema.

Por ejemplo:

"Sobre David"

o

"Sobre la fe"
`;

    }


    /* =================================================
       DETECTAR TEMA
    ================================================= */

    if (

        texto.startsWith("sobre ") ||

        texto.startsWith("acerca de ")

    ) {

        let tema = mensaje
            .replace(/^sobre /i, "")
            .replace(/^acerca de /i, "")
            .trim();


        CHINO.contexto.tema = tema;


        return `
🔥 TEMA REGISTRADO

📖 Prédica: ${tema}

Ahora dime para quién quieres prepararla.

Por ejemplo:

"Para jóvenes"

o

"Para toda la iglesia"
`;

    }


    /* =================================================
       DETECTAR AUDIENCIA
    ================================================= */

    if (

        texto.includes("para jovenes") ||

        texto.includes("para joven")

    ) {

        CHINO.contexto.audiencia = "Jóvenes";


        return `
👥 AUDIENCIA REGISTRADA

Perfecto.

📖 Tema: ${CHINO.contexto.tema || "Pendiente"}

👥 Audiencia: Jóvenes

Ya tengo el contexto.

Puedes decirme:

"Dame 3 puntos"
`;

    }


    /* =================================================
       GENERAR 3 PUNTOS
    ================================================= */

    if (

        texto.includes("dame 3 puntos") ||

        texto.includes("hazme 3 puntos") ||

        texto.includes("quiero 3 puntos") ||

        texto.includes("tres puntos") ||

        texto === "3 puntos"

    ) {


        if (!CHINO.contexto.tema) {

            return `
🧠 Todavía no tengo registrado el tema.

Primero dime:

"Sobre David"

por ejemplo.
`;

        }


        const tema = normalizarTexto(
            CHINO.contexto.tema
        );


        /* ---------------------------------------------
           DAVID
        --------------------------------------------- */

        if (tema.includes("david")) {

            CHINO.contexto.detalles = [

                "David aprendió a confiar en Dios antes de enfrentar a Goliat.",

                "David no permitió que las opiniones de otros definieran su identidad.",

                "David aprendió a esperar el tiempo de Dios para cumplir su propósito."

            ];


            return `
🔥 PRÉDICA: ${CHINO.contexto.tema.toUpperCase()}

👥 Audiencia: ${
                CHINO.contexto.audiencia || "General"
            }


1️⃣ David aprendió a confiar en Dios antes de enfrentar a Goliat.


2️⃣ David no permitió que las opiniones de otros definieran su identidad.


3️⃣ David aprendió a esperar el tiempo de Dios para cumplir su propósito.


📌 Contexto conservado.

Tema: ${CHINO.contexto.tema}

Audiencia: ${
                CHINO.contexto.audiencia || "General"
            }

Puedes decirme:

"Desarrolla el punto 2"
`;

        }


        /* ---------------------------------------------
           TEMA GENERAL
        --------------------------------------------- */

        CHINO.contexto.detalles = [

            `El primer principio que podemos aprender de ${CHINO.contexto.tema} es confiar en Dios.`,

            `El segundo principio es mantener nuestra identidad y propósito en Dios.`,

            `El tercer principio es aprender a esperar el tiempo de Dios.`

        ];


        return `
🔥 PRÉDICA: ${CHINO.contexto.tema.toUpperCase()}

👥 Audiencia: ${
            CHINO.contexto.audiencia || "General"
        }


1️⃣ ${CHINO.contexto.detalles[0]}


2️⃣ ${CHINO.contexto.detalles[1]}


3️⃣ ${CHINO.contexto.detalles[2]}


📌 Contexto conservado.

Ahora puedes decir:

"Desarrolla el punto 2"
`;

    }


    /* =================================================
       DESARROLLAR PUNTO
    ================================================= */

    if (

        texto.includes("desarrolla el punto") ||

        texto.includes("desarrollar el punto") ||

        texto.includes("explica el punto")

    ) {


        let numeroPunto = null;


        if (

            texto.includes("punto 1") ||

            texto.includes("punto uno")

        ) {

            numeroPunto = 1;

        }


        if (

            texto.includes("punto 2") ||

            texto.includes("punto dos")

        ) {

            numeroPunto = 2;

        }


        if (

            texto.includes("punto 3") ||

            texto.includes("punto tres")

        ) {

            numeroPunto = 3;

        }


        if (

            numeroPunto &&

            CHINO.contexto.detalles.length >= numeroPunto

        ) {

            const punto =

                CHINO.contexto.detalles[
                    numeroPunto - 1
                ];


            return `
📖 DESARROLLO DEL PUNTO ${numeroPunto}


🔥 Tema:

${CHINO.contexto.tema}


👥 Audiencia:

${CHINO.contexto.audiencia || "General"}


🎯 Punto:

${punto}


🧠 CHINO reconoce que estás continuando con el contexto de tu prédica.


Ahora podemos desarrollar este punto con:

📖 Texto bíblico
💡 Explicación
🔥 Aplicación
🎤 Ejemplo
🙏 Conclusión
`;

        }


        return `
🧠 No encontré el punto que quieres desarrollar.

Primero genera los 3 puntos de la prédica.

Por ejemplo:

"Dame 3 puntos"

y después:

"Desarrolla el punto 2"
`;

    }


    /* =================================================
       MÓDULO BIBLIA
    ================================================= */

    if (analisis.modulo === "Biblia") {

        return `
📖 MÓDULO BIBLIA ACTIVADO

Puedo ayudarte a trabajar:

• Prédicas
• Estudios bíblicos
• Versículos
• Personajes bíblicos
• Bosquejos
• Aplicaciones
• Enseñanzas

¿Qué quieres preparar?
`;

    }


    /* =================================================
       MÓDULO MÚSICA
    ================================================= */

    if (analisis.modulo === "Música") {

        return `
🎵 MÓDULO MÚSICA ACTIVADO

Podemos trabajar:

🎸 Acordes
🎹 Teclado
🥁 Batería
🎼 Escalas
🎤 Adoración
📚 Ejercicios

Dime qué quieres aprender.
`;

    }


    /* =================================================
       MÓDULO PODCAST
    ================================================= */

    if (analisis.modulo === "Podcast") {

        return `
🎙️ MÓDULO PODCAST ACTIVADO

Puedo ayudarte con:

• Ideas
• Guiones
• Preguntas
• Títulos
• Estructura
• Contenido

¿Qué quieres preparar?
`;

    }


    /* =================================================
       RESPUESTA GENERAL
    ================================================= */

    return `
🤖 Soy CHINO AI 3.0.

Entendí tu mensaje:

"${mensaje}"

Mi cerebro central todavía está creciendo, pero ya puedo reconocer diferentes módulos y mantener el contexto de nuestras conversaciones.
`;

}


/* =====================================================
   MOSTRAR MENSAJE DEL USUARIO
===================================================== */

function mostrarMensajeUsuario(mensaje) {

    const chat = document.getElementById("chat");


    const elemento = document.createElement("div");

    elemento.className = "message user";


    elemento.innerHTML =
        "👤 <strong>Tú:</strong> ";


    const texto = document.createTextNode(mensaje);

    elemento.appendChild(texto);


    chat.appendChild(elemento);

}


/* =====================================================
   MOSTRAR RESPUESTA DE CHINO
===================================================== */

function mostrarRespuesta(respuesta) {

    const chat = document.getElementById("chat");


    const elemento = document.createElement("div");

    elemento.className = "message CHINO";


    const titulo = document.createElement("strong");

    titulo.textContent = "🤖 CHINO: ";


    elemento.appendChild(titulo);


    const texto = document.createTextNode(respuesta);

    elemento.appendChild(texto);


    chat.appendChild(elemento);


    chat.scrollTop = chat.scrollHeight;

}


/* =====================================================
   ENVIAR MENSAJE
===================================================== */

function enviarMensaje() {


    const input =
        document.getElementById("userInput");


    const mensaje =
        input.value.trim();


    if (mensaje === "") {

        return;

    }


    /* GUARDAR MENSAJE */

    guardarMemoria(
        "usuario",
        mensaje
    );


    /* MOSTRAR MENSAJE */

    mostrarMensajeUsuario(
        mensaje
    );


    /* LIMPIAR ENTRADA */

    input.value = "";


    /* PROCESAMIENTO */

    setTimeout(function() {


        /* ANALIZAR */

        const analisis =
            analizarIntencion(
                mensaje
            );


        /* ACTUALIZAR MÓDULO */

        CHINO.moduloActual =
            analisis.modulo;


        console.log(
            "Análisis:",
            analisis
        );


        /* GENERAR */

        const respuesta =
            generarRespuesta(
                mensaje,
                analisis
            );


        /* GUARDAR RESPUESTA */

        guardarMemoria(
            "CHINO",
            respuesta
        );


        /* MOSTRAR RESPUESTA */

        mostrarRespuesta(
            respuesta
        );


    }, 500);

}


/* =====================================================
   CAMBIAR MÓDULO
===================================================== */

function modulo(nombre) {


    CHINO.moduloActual =
        nombre;


    const chat =
        document.getElementById("chat");


    let respuesta = "";


    if (nombre === "Biblia") {

        respuesta = `
📖 Módulo Biblia activado.

Estoy listo para ayudarte con:

Prédicas
Estudios
Versículos
Personajes bíblicos
Enseñanzas
`;

    }


    if (nombre === "Música") {

        respuesta = `
🎵 Módulo Música activado.

Estoy listo para trabajar:

Acordes
Escalas
Guitarra
Teclado
Batería
Adoración
`;

    }


    if (nombre === "Podcast") {

        respuesta = `
🎙️ Módulo Podcast activado.

Estoy listo para trabajar:

Ideas
Guiones
Preguntas
Títulos
Contenido
`;

    }


    if (nombre === "Asistente") {

        respuesta = `
🧠 Asistente central activado.

CHINO está listo para coordinar tus tareas.
`;

    }


    mostrarRespuesta(
        respuesta
    );


    guardarMemoria(
        "CHINO",
        respuesta
    );

}


/* =====================================================
   INICIO
===================================================== */

console.log(
    "CHINO AI 3.0 iniciado correctamente."
);

console.log(
    "Módulo actual:",
    CHINO.moduloActual
);

</script>

</body>

</html>
